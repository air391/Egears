# Demo 2: Step mode — 29 columns (full step-point data + pdg0, k0, etotal)
/control/verbose 0
/geometry/source detector.tg
/sensitive/add HPGe
/sensitive/add chamber
/output/mode step
/output/maxSteps 50000
/run/initialize
/gps/particle gamma
/gps/energy 2.6 MeV
/gps/ang/type iso
/gps/ang/minphi 180 deg
/gps/ang/maxphi 270 deg
/gps/ang/mintheta 40 deg
/gps/ang/maxtheta 150 deg
/vis/disable
/tracking/verbose 0
/analysis/setFileName demo_step.root
/run/verbose 2
/run/printProgress 10000
/run/beamOn 50000
