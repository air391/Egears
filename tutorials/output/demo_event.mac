# Demo 1: Event mode — 6 columns (n, m, pdg0, k0, etotal, et)
/control/verbose 0
/geometry/source detector.tg
/sensitive/add HPGe
/sensitive/add chamber
/output/mode event
/run/initialize
/gps/particle gamma
/gps/energy 2.6 MeV
/gps/ang/type iso
/gps/ang/minphi 180 deg
/gps/ang/maxphi 270 deg
/gps/ang/mintheta 40 deg
/gps/ang/maxtheta 150 deg
/vis/disable
/tracking/verbose 0
/analysis/setFileName demo_event.root
/run/verbose 2
/run/printProgress 10000
/run/beamOn 50000
