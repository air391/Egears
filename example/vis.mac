# vis.mac - Qt visualization, text geometry
/geometry/source detector.tg
/sensitive/add crystal
/output/mode event
/output/maxSteps 50000
/run/initialize
/gps/particle gamma
/gps/energy 2.6 MeV
/gps/ang/type iso
/gps/ang/mintheta 30 deg
/gps/ang/maxtheta 150 deg
/vis/open OGLSQt
/vis/drawVolume
/vis/scene/add/trajectories
/vis/scene/endOfEventAction accumulate 10
/run/beamOn 50
/vis/viewer/flush
