// Germanium detector in aluminum housing
// Units: mm (Geant4 default)

:volu world BOX 200 200 200 G4_AIR
:vis world OFF

:volu can TUBE 0 40 50 G4_Al
:volu vacuum TUBE 0 38 48 G4_Galactic
:volu crystal TUBE 0 35 45 G4_Ge

:color can 0.7 0.7 0.7
:color vacuum 0.9 0.9 1.0
:color crystal 0.2 0.4 0.8

:rotm r000 0 0 0
:place can 1 world r000 0 0 0
:place vacuum 0 can r000 0 0 0
:place crystal 0 vacuum r000 0 0 0
